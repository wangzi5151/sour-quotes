{
  "appId": "com.sourquotes.daily",
  "appName": "每日毒鸡汤",
  "webDir": "dist",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "launchShowDuration": 1500,
      "backgroundColor": "#121212",
      "showSpinner": true,
      "spinnerColor": "#ff6b81",
      "androidScaleType": "CENTER_CROP",
      "splashFullScreen": true,
      "splashImmersive": true
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#121212"
    }
  }
}
